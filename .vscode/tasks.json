{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Erase Flash",
            "type": "process",
            "command": "${userHome}/.platformio/penv/bin/pio",
            "args": [
                "run",
                "--target", "erase"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "2. Upload Firmware",
            "type": "process",
            "command": "${userHome}/.platformio/penv/bin/pio",
            "args": [
                "run",
                "--target", "upload"
            ],
            "dependsOn": "1. Erase Flash",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "PlatformIO: 1st Time Factory Flash",
            "type": "process",
            "command": "${userHome}/.platformio/penv/bin/pio",
            "args": [
                "pkg", "exec", "-p", "tool-esptoolpy", "-c", "esptool.py write_flash 0x810000 ffat_golden.bin"
            ],
            "dependsOn": "2. Upload Firmware",
            "problemMatcher": [
                "$platformio"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}